# Normalise every text file to LF in the repository, regardless of the contributor's platform.
# Paired with .editorconfig so the formatter and the VCS agree on what a line ending is.

* text=auto eol=lf

# Sources and configuration — always LF.
*.java      text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf
*.gradle    text eol=lf
*.properties text eol=lf
*.xml       text eol=lf
*.fxml      text eol=lf
*.css       text eol=lf
*.sql       text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.sh        text eol=lf
gradlew     text eol=lf

# Windows-only scripts must keep CRLF or cmd.exe mis-parses them.
*.bat       text eol=crlf
*.cmd       text eol=crlf
gradlew.bat text eol=crlf

# Binary — never touched by line-ending normalisation or diffed as text.
*.jar       binary
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.icns      binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.zip       binary
*.epub      binary
*.fb2z      binary
*.db        binary
