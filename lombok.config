# Lombok configuration — repository root, inherited by every module.
#
# `stopBubbling` marks this as the top of the config chain, so Lombok never walks above the repository root
# looking for another `lombok.config` on a contributor's machine.
config.stopBubbling = true

# Lombok desugars `@RequiredArgsConstructor`/`@Slf4j`/`@Builder` BEFORE the Error Prone javac plugin walks the
# tree, so NullAway analyses the generated constructor rather than the annotation. Without this setting the
# generated parameters carry no nullability information at all, and NullAway raises a false non-null violation
# on every `@RequiredArgsConstructor` service (01_BUILD_AND_TOOLING.md#error-prone-lombok, DD-05, ADR-0014).
#
# `JSPECIFY` emits `org.jspecify.annotations.@Nullable`, matching the `@NullMarked` package markers that switch
# NullAway on in the first place.
lombok.addNullAnnotations = JSPECIFY
