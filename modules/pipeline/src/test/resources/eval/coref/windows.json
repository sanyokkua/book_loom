   "pronouns": [
     {"quote": "he never once", "pronoun": "he", "referent": "OTHER", "who": "Tovrin", "inSpeech": false}]},
  {"id": "first-02", "target": "Odrek", "shape": "first-person-narrator",
   "paragraphs": [
