<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ua.bookloom.ui.screen.StructureController" id="structure-screen" spacing="14">
    <Label id="structure-title" styleClass="screen-title" text="%structure.title"/>
    <VBox fx:id="stateHost" id="structure-state" spacing="14" VBox.vgrow="ALWAYS"/>
</VBox>
