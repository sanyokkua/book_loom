<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ua.bookloom.ui.screen.GenerationController" id="settings-generation-host" spacing="10">
    <padding>
        <Insets top="14"/>
    </padding>
    <VBox fx:id="columns" id="generation-columns"/>
    <fx:define>
        <VBox fx:id="qualityCard" id="generation-quality-card" styleClass="card" spacing="10">
            <HBox spacing="8" alignment="BASELINE_LEFT">
                <Label styleClass="card-title" text="%settings.generation.quality.title"/>
                <Label styleClass="hint" text="%settings.generation.quality.sub"/>
            </HBox>
            <VBox fx:id="qualityBody" id="generation-quality-body"/>
            <Label id="generation-quality-same" styleClass="hint" wrapText="true" text="%settings.generation.quality.same"/>
        </VBox>
        <VBox fx:id="right" id="generation-right" spacing="10">
            <VBox fx:id="limits" id="generation-limits" styleClass="card" spacing="2">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label styleClass="card-title" text="%settings.generation.limits"/>
                    <Label styleClass="tag-note" text="%settings.generation.limits.fixed"/>
                </HBox>
            </VBox>
        </VBox>
    </fx:define>
</VBox>
