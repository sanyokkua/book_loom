<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ua.bookloom.ui.screen.BookBriefController" id="brief-screen" styleClass="brief-scroll"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="14">
        <padding>
            <Insets right="8"/>
        </padding>
        <Label id="brief-title" styleClass="screen-title" text="%brief.title"/>
        <VBox fx:id="stateHost" id="brief-state" spacing="14"/>
    </VBox>
</ScrollPane>
