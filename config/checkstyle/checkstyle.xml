<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  BookLoom Checkstyle ruleset.

  Scope: the naming and structural conventions Spotless does NOT cover. Spotless (Palantir Java Format) decides
  where the characters go; it never judges what they say. So there is deliberately nothing here about
  indentation, brace placement, line wrapping or import ORDER — Palantir owns all of that, and a second opinion
  would only produce two tools fighting over the same file.

  Rules are drawn from `.claude/rules/java-coding-style.md`:
    - naming: PascalCase types, camelCase methods/fields, UPPER_SNAKE constants
    - size: methods <= 30 lines, files <= 400 lines, nesting depth <= 3
    - hygiene: no star imports, no unused imports, no `sun.*`, modifiers in canonical order
    - logging: no hand-written `LoggerFactory.getLogger(` outside the bootstrap-exempt packages (`@Slf4j`
      everywhere else) — a source-text check because ArchUnit cannot see past Lombok's generated bytecode

  Every violation is severity=error: a style rule that only warns is a style rule nobody obeys
  (docs/specification/04_Build_and_Release/02_QUALITY_GATES.md#tools).
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="charset" value="UTF-8"/>
    <property name="fileExtensions" value="java"/>

    <!-- Lets `@SuppressWarnings("checkstyle:RuleName")` in source suppress a rule, so an exception is a
         reviewable annotation at the site rather than a silent widening of the ruleset. -->
    <module name="SuppressWarningsFilter"/>

    <!-- Off-by-default exclusions for generated and declaration-only files, kept in one readable place. -->
    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
    </module>

    <!-- Class size. Methods are bounded inside TreeWalker; a file is bounded here because Checkstyle counts
         file length before parsing. -->
    <module name="FileLength">
        <property name="max" value="400"/>
    </module>

    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>

        <!-- ===== Naming ===== -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="LocalFinalVariableName"/>
        <module name="ConstantName"/>
        <module name="StaticVariableName"/>
        <module name="RecordComponentName"/>
        <module name="RecordTypeParameterName"/>
        <module name="ClassTypeParameterName"/>
        <module name="MethodTypeParameterName"/>

        <!-- ===== Size and shape ===== -->
        <module name="MethodLength">
            <property name="max" value="30"/>
            <property name="countEmpty" value="false"/>
        </module>
        <module name="NestedIfDepth">
            <property name="max" value="3"/>
        </module>
        <module name="NestedTryDepth">
            <property name="max" value="3"/>
        </module>
        <module name="OuterTypeNumber"/>
        <module name="OneTopLevelClass"/>

        <!-- ===== Imports ===== -->
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <module name="IllegalImport">
            <!-- `sun.*` is unsupported internal API; `junit.framework` is JUnit 3, and the stack is JUnit 5. -->
            <property name="illegalPkgs" value="sun, junit.framework"/>
        </module>

        <!-- ===== Correctness-adjacent conventions ===== -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>
        <module name="EqualsHashCode"/>
        <module name="CovariantEquals"/>
        <module name="StringLiteralEquality"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="FallThrough"/>
        <module name="DefaultComesLast"/>
        <module name="EmptyStatement"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="ArrayTypeStyle"/>
        <module name="UpperEll"/>

        <!-- A utility class with a public default constructor is an instantiable class pretending not to be. -->
        <module name="HideUtilityClassConstructor"/>
        <!-- A class with only private constructors is final in fact; say so. -->
        <module name="FinalClass"/>

        <!-- ===== Logging boilerplate ===== -->
        <!-- Bans a hand-written `LoggerFactory.getLogger(` call in production code (java-coding-style.md,
             logging.md): every class takes a logger via Lombok `@Slf4j` instead. ArchUnit's
             `bootstrap-no-static-logger` cannot enforce this — a Lombok-generated logger field and a
             hand-written one compile to identical bytecode, so only a source-text check can tell them apart.
             Suppressed for `src/test`/`src/archTest` (legitimate direct use: assertions on bootstrap logging,
             and the ArchUnit violation fixtures that must call it to model the very thing this rule forbids) and
             for the bootstrap-exempt packages, in `suppressions.xml`. -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="BannedLoggerFactoryCall"/>
            <property name="format" value="LoggerFactory\.getLogger\("/>
            <property name="ignoreComments" value="true"/>
            <property name="message"
                      value="Use Lombok @Slf4j instead of a hand-written LoggerFactory.getLogger(...) call (java-coding-style.md, logging.md). The only exemption is ua.bookloom.app.bootstrap / ua.bookloom.util.paths, which take a local logger after the log directory is published."/>
        </module>
    </module>
</module>
